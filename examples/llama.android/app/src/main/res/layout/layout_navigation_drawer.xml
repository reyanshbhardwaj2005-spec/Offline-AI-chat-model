<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="310dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingTop="24dp"
    android:paddingBottom="12dp">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="AI"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_ai_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local AI"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#171717" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline assistant"
                android:textSize="12sp"
                android:textColor="#777777"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- MAIN NAVIGATION -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- NEW CHAT -->

        <LinearLayout
            android:id="@+id/drawerNewChat"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_drawer_item">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="+"
                android:textSize="28sp"
                android:textColor="#333333" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="New chat"
                android:textSize="15sp"
                android:textColor="#222222"
                android:paddingStart="8dp" />

        </LinearLayout>


        <!-- MODELS -->

        <LinearLayout
            android:id="@+id/drawerModels"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_drawer_item">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="◈"
                android:textSize="20sp"
                android:textColor="#333333" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Models"
                android:textSize="15sp"
                android:textColor="#222222"
                android:paddingStart="8dp" />

        </LinearLayout>


        <!-- IMAGES -->

        <LinearLayout
            android:id="@+id/drawerImages"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_drawer_item">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="▧"
                android:textSize="22sp"
                android:textColor="#333333" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Images"
                android:textSize="15sp"
                android:textColor="#222222"
                android:paddingStart="8dp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- DIVIDER -->
    <!-- ========================================================= -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="#E8E8E8" />


    <!-- ========================================================= -->
    <!-- HISTORY TITLE -->
    <!-- ========================================================= -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HISTORY"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#888888"
        android:letterSpacing="0.08"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="8dp" />


    <!-- ========================================================= -->
    <!-- HISTORY LIST -->
    <!-- ========================================================= -->

    <ScrollView
        android:id="@+id/historyScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

    </ScrollView>


    <!-- ========================================================= -->
    <!-- BOTTOM SECTION -->
    <!-- ========================================================= -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:background="#E8E8E8" />


    <!-- SETTINGS -->

    <LinearLayout
        android:id="@+id/drawerSettings"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="22dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_drawer_item">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⚙"
            android:textSize="21sp"
            android:textColor="#444444" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Settings"
            android:textSize="15sp"
            android:textColor="#222222"
            android:paddingStart="8dp" />

    </LinearLayout>


    <!-- PROFILE -->

    <LinearLayout
        android:id="@+id/drawerProfile"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="22dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_drawer_item">

        <TextView
            android:id="@+id/profileAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="U"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_profile_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/profileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local profile"
                android:textSize="11sp"
                android:textColor="#888888"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="25sp"
            android:textColor="#888888" />

    </LinearLayout>

</LinearLayout>
